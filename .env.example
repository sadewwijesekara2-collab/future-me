# Copy this file to ".env" and fill in your own key. NEVER commit ".env".

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: comma-separated models, tried in order (see https://openrouter.ai/models)
# OPENROUTER_MODELS=google/gemini-2.0-flash-001,meta-llama/llama-3.3-70b-instruct:free

# Optional
PORT=5000
FLASK_DEBUG=false
